DATABASE_URL=postgresql://...

# QuickDL credits
MONTHLY_FREE_CREDITS=50
VIDEO_CREDIT_COST=2
MAX_FILE_MB=300
KEEP_FILE_HOURS=6

# Downloader
STRICT_PLATFORM_TOGGLES=false
WORKER_POLL_SECONDS=0.7

# PayPal LIVE
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_LIVE_CLIENT_SECRET
PAYPAL_CURRENCY=USD
PAYPAL_DOMAIN=https://quickdl.site
PAYPAL_WEBHOOK_ID=YOUR_LIVE_WEBHOOK_ID

# Google Sign-In
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID

# Spacemail authentication + welcome emails
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=support@quickdl.site
SMTP_PASSWORD=YOUR_SPACEMAIL_MAILBOX_PASSWORD
EMAIL_FROM=QuickDL <support@quickdl.site>
AUTH_CODE_MINUTES=10

# Stable browser identity
COOKIE_SECURE=true

# Admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Email delivery
# Render Free blocks outbound SMTP ports 25/465/587. For Free Render, use Resend over HTTPS.
EMAIL_PROVIDER=resend
# Set true to require email verification even when no provider is configured.
# Default false keeps signup usable on a fresh deployment; when Resend/SMTP is configured, verification is automatic.
EMAIL_AUTH_REQUIRE_VERIFICATION=false
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=QuickDL <support@quickdl.site>
RESEND_REPLY_TO=support@quickdl.site
